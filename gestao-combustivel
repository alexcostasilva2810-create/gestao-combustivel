import streamlit as st
import sqlite3
import pandas as pd
from datetime import date

# Configuração do Banco de Dados
def init_db():
    conn = sqlite3.connect('dados_combustivel.db')
    c = conn.cursor()
    c.execute('''CREATE TABLE IF NOT EXISTS abastecimentos 
                 (data TEXT, km REAL, litros REAL, preco REAL, tipo TEXT)''')
    conn.commit()
    conn.close()

init_db()

# Interface do App
st.title("⛽ Gestão de Combustível")

with st.form("form_abastecimento", clear_on_submit=True):
    col1, col2 = st.columns(2)
    with col1:
        data = st.date_input("Data", date.today())
        km = st.number_input("Quilometragem Atual (KM)", min_value=0.0, step=1.0)
    with col2:
        litros = st.number_input("Litros abastecidos", min_value=0.0, step=0.1)
        preco = st.number_input("Valor Total (R$)", min_value=0.0, step=0.01)
    
    tipo = st.selectbox("Tipo de Combustível", ["Gasolina", "Etanol", "Diesel", "GNV"])
    btn_salvar = st.form_submit_button("Registrar Abastecimento")

if btn_salvar:
    conn = sqlite3.connect('dados_combustivel.db')
    c = conn.cursor()
    c.execute("INSERT INTO abastecimentos VALUES (?,?,?,?,?)", (data, km, litros, preco, tipo))
    conn.commit()
    conn.close()
    st.success("Registrado com sucesso!")

# Visualização simples
if st.checkbox("Mostrar histórico"):
    conn = sqlite3.connect('dados_combustivel.db')
    df = pd.read_sql_query("SELECT * FROM abastecimentos", conn)
    st.dataframe(df)
    conn.close()
